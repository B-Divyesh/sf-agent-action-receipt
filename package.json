{
  "name": "@sociobot/agent-action-receipt",
  "version": "0.1.2",
  "description": "Signed, privacy-preserving hash-chain receipts for consequential agent tool calls.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:lib && npm run build:site",
    "build:lib": "rm -rf dist/esm dist/cjs && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/rename-cjs.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test": "npm run build:lib && node --test test/ledger.test.mjs",
    "test:browser": "npm run build:site && node --test test/site.test.mjs",
    "test:consumer": "npm run build && node --test test/consumer.test.mjs",
    "test:claims": "npm run claim:receipt-invariant && npm run claim:private-signed-bundle && npm run claim:ledger-order && npm run claim:restart-recovery && npm run claim:tamper-detection && npm run claim:package-artifact && npm run claim:demo-sandbox && npm run claim:offline-reload",
    "claim:receipt-invariant": "npm run build:lib && node --test --test-name-pattern='@claim:receipt-invariant' test/ledger.test.mjs",
    "claim:private-signed-bundle": "npm run build:lib && node --test --test-name-pattern='@claim:private-signed-bundle' test/ledger.test.mjs",
    "claim:ledger-order": "npm run build:lib && node --test --test-name-pattern='@claim:ledger-order' test/ledger.test.mjs",
    "claim:restart-recovery": "npm run build:lib && node --test --test-name-pattern='@claim:restart-recovery' test/ledger.test.mjs",
    "claim:tamper-detection": "npm run build:lib && node --test --test-name-pattern='@claim:tamper-detection' test/ledger.test.mjs",
    "claim:package-artifact": "npm run build && node --test --test-name-pattern='@claim:package-artifact' test/consumer.test.mjs",
    "claim:demo-sandbox": "npm run build:site && node --test --test-name-pattern='@claim:demo-sandbox' test/site.test.mjs",
    "claim:offline-reload": "npm run build:site && node --test --test-name-pattern='@claim:offline-reload' test/site.test.mjs",
    "dev": "npm run build:site && node scripts/serve.mjs",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@types/node": "^22.10.2",
    "playwright": "^1.58.2",
    "typescript": "^5.7.2"
  }
}
